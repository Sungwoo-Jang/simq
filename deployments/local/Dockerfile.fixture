# syntax=docker/dockerfile:1.7

FROM golang:1.26.7-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/fixture ./tests/integration/fixture

FROM alpine:3.23
COPY --from=build /out/fixture /usr/local/bin/simq-test-fixture
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/simq-test-fixture"]
